(define (mk name base precision compress mode-top group mask)
  (let* ((img (car (gimp-image-new 300 200 base)))
         (ltype (if (= base GRAY) GRAYA-IMAGE RGBA-IMAGE))
         (bg (car (gimp-layer-new img 300 200 (if (= base GRAY) GRAY-IMAGE RGB-IMAGE) "Background" 100 LAYER-MODE-NORMAL)))
         (a (car (gimp-layer-new img 180 120 ltype "Red box" 100 LAYER-MODE-NORMAL)))
         (b (car (gimp-layer-new img 160 150 ltype "Blue blob" 70 mode-top)))
         (h (car (gimp-layer-new img 300 200 ltype "Hidden" 100 LAYER-MODE-NORMAL))))
    (gimp-image-insert-layer img bg 0 -1)
    (gimp-context-set-background '(245 240 225)) (gimp-drawable-fill bg FILL-BACKGROUND)
    (gimp-image-insert-layer img a 0 -1) (gimp-layer-set-offsets a 30 20)
    (gimp-drawable-fill a FILL-TRANSPARENT)
    (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 40 30 150 90)
    (gimp-context-set-foreground '(200 30 40)) (gimp-drawable-edit-fill a FILL-FOREGROUND)
    (if (> group 0)
      (let ((g (car (gimp-layer-group-new img))))
        (gimp-image-insert-layer img g 0 -1) (gimp-layer-set-opacity g 80) (if (= group 2) (gimp-layer-set-mode g LAYER-MODE-PASS-THROUGH))
        (gimp-image-insert-layer img b g -1))
      (gimp-image-insert-layer img b 0 -1))
    (gimp-layer-set-offsets b 120 -20)
    (gimp-drawable-fill b FILL-TRANSPARENT)
    (gimp-image-select-ellipse img CHANNEL-OP-REPLACE 130 10 140 150)
    (gimp-selection-feather img 12)
    (gimp-context-set-foreground '(30 80 210)) (gimp-drawable-edit-fill b FILL-FOREGROUND)
    (gimp-selection-none img)
    (if (= mask 1)
      (let ((m (car (gimp-layer-create-mask a ADD-MASK-WHITE))))
        (gimp-layer-add-mask a m)
        (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 30 20 60 120)
        (gimp-context-set-foreground '(0 0 0)) (gimp-drawable-edit-fill m FILL-FOREGROUND)
        (gimp-selection-none img)))
    (gimp-image-insert-layer img h 0 0)
    (gimp-context-set-foreground '(0 255 0)) (gimp-drawable-fill h FILL-FOREGROUND)
    (gimp-item-set-visible h FALSE)
    (if (> precision 0) (gimp-image-convert-precision img precision))
    (gimp-image-set-resolution img 300 300)
    (if (= base INDEXED) #t #t)
    (if (= compress 1) (gimp-xcf-save 0 img bg (string-append name ".xcf") (string-append name ".xcf"))
                       (gimp-xcf-save 0 img bg (string-append name ".xcf") (string-append name ".xcf")))
    (let ((flat (car (gimp-image-merge-visible-layers img CLIP-TO-IMAGE))))
      (file-png-save-defaults RUN-NONINTERACTIVE img flat (string-append name ".png") (string-append name ".png")))
    (gimp-image-delete img)))
(mk "v_plain" RGB 0 0 LAYER-MODE-NORMAL 0 0)
(mk "v_legacy" RGB 0 0 LAYER-MODE-NORMAL-LEGACY 0 0)
(mk "v_mask" RGB 0 0 LAYER-MODE-NORMAL-LEGACY 0 1)
(mk "v_group" RGB 0 0 LAYER-MODE-NORMAL-LEGACY 1 0)
(mk "v_multiply" RGB 0 0 LAYER-MODE-MULTIPLY-LEGACY 0 0)
(mk "v_screen" RGB 0 0 LAYER-MODE-SCREEN-LEGACY 0 0)
(mk "v_multiply_new" RGB 0 0 LAYER-MODE-MULTIPLY 0 0)
(mk "v_gray" GRAY 0 0 LAYER-MODE-NORMAL-LEGACY 0 0)
(mk "v_u16" RGB PRECISION-U16-GAMMA 0 LAYER-MODE-NORMAL-LEGACY 0 0)
(mk "v_u16lin" RGB PRECISION-U16-LINEAR 0 LAYER-MODE-NORMAL-LEGACY 0 0)
