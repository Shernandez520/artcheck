(mk "v_screen_new" RGB 0 0 LAYER-MODE-SCREEN 0 0)
(mk "v_overlay" RGB 0 0 LAYER-MODE-OVERLAY 0 0)
(mk "v_overlay_legacy" RGB 0 0 LAYER-MODE-OVERLAY-LEGACY 0 0)
