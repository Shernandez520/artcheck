(mk "v_sub" RGB 0 0 LAYER-MODE-SUBTRACT 0 0)
(mk "v_dark" RGB 0 0 LAYER-MODE-DARKEN-ONLY 0 0)
(mk "v_light" RGB 0 0 LAYER-MODE-LIGHTEN-ONLY 0 0)
(mk "v_dodge" RGB 0 0 LAYER-MODE-DODGE 0 0)
(mk "v_u32" RGB PRECISION-U32-LINEAR 0 LAYER-MODE-NORMAL 0 0)
